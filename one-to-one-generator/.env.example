# Settings for the automated 1-to-1 match. Copy to .env.local for development, or set these on the container.
# Placeholders only. Never commit real values.

# Master switch for the scheduled match email. Default false.
AUTOMATION_ENABLED=false
# true writes emails to files instead of sending them. Default true. Only the exact word false turns real sending on.
DRY_RUN=true

# Where the pairs (or the please-update note) are emailed.
MATCH_TO=chapter@example.org
# Comma list of leadership addresses allowed to sign in and update the roster. Empty means nobody can.
LEADERSHIP_EMAILS=

# Email sending (the same setup as the ClearSky contact form). Needed when DRY_RUN=false.
RESEND_API_KEY=
CONTACT_FORM_SENDER=

# Long random values (CRON_SECRET at least 16 characters, SESSION_SECRET at least 32).
CRON_SECRET=
SESSION_SECRET=

# Folder for the SQLite file (roster, history, sign-in state). Mount a volume here.
BNI_STATE_DIR=.state
# Proxies that append to X-Forwarded-For in front of the app (1 to 5). Cloudflare plus Nginx Proxy Manager is 2.
TRUSTED_PROXY_HOPS=1

# How often a round goes out: weekly (every Tuesday), biweekly (default) or monthly (first Tuesday of the month).
# The cron job still runs every Tuesday; the app decides. Anything else fails closed.
BNI_SCHEDULE=biweekly
# biweekly only: the first round day (YYYY-MM-DD) and the days between rounds.
BNI_ANCHOR_DATE=2026-11-17
BNI_ROUND_DAYS=14
# How many past rounds count when avoiding repeat pairs.
HISTORY_ROUNDS=4
# Send a please-update email instead of a match when the roster is older than this many days.
ROSTER_STALE_DAYS=60

# Local testing only (needs DRY_RUN=true and TOOL_URL=http://localhost:PORT/chaptertools).
# BNI_DEV_LOCAL=false
# Public address of the tool, used in email links.
TOOL_URL=https://apps.cscloud.digital/chaptertools
